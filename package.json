{
  "name": "element-nuwa",
  "version": "1.6.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "BROWSER='Google Chrome' npm run dev -- --open",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:reactions": "node --test scripts/test-reactions.mjs",
    "test:challenges": "node --test scripts/test-challenges.mjs",
    "test": "node --test scripts/test-*.mjs",
    "data:refresh": "python3 scripts/data/import_explorer.py --download",
    "data:promote": "python3 scripts/data/import_explorer.py --promote"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
